+// Boaz: the search provider an image search goes to, `provider` when given,
+// otherwise the default search provider. `storage` keeps a given one alive.
+const TemplateURL* ImageSearchProvider(
+    TemplateURLService* template_url_service,
+    const std::optional<TemplateURLData>& provider,
+    std::optional<TemplateURL>& storage) {
+  if (!provider) {
+    return template_url_service->GetDefaultSearchProvider();
+  }
+  return &storage.emplace(*provider);
+}
