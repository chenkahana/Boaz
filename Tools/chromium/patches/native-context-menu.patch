+      IDC_SPELLCHECK_ADD_TO_DICTIONARY,
+      IDC_CONTENT_CONTEXT_INSPECTELEMENT,
+  };
+  for (size_t i = menu.GetItemCount(); i-- > 0;) {
+    const int id = menu.GetCommandIdAt(i);
+    if (menu.GetTypeAt(i) != ui::MenuModel::TYPE_SEPARATOR && std::ranges::find(kKept, id) == std::ranges::end(kKept) &&
+        !(id >= IDC_SPELLCHECK_SUGGESTION_0 && id < IDC_SPELLCHECK_LANGUAGES_FIRST) &&
+        !RenderViewContextMenuBase::IsContentCustomCommandId(id) &&
+        !ContextMenuMatcher::IsExtensionsCustomCommandId(id)) {
+      menu.RemoveItemAt(i);
+    }
+  }
+  // No separator first, last or next to another.
+  for (size_t i = menu.GetItemCount(); i-- > 0;) {
+    if (menu.GetTypeAt(i) == ui::MenuModel::TYPE_SEPARATOR &&
+        (i == 0 || i + 1 == menu.GetItemCount() || menu.GetTypeAt(i - 1) == ui::MenuModel::TYPE_SEPARATOR)) {
