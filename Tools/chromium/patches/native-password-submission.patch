+base::UnguessableToken ChromePasswordManagerClient::CaptureExternalPasswordSubmission(
+    PasswordManagerDriver* driver) {
+#if BUILDFLAG(IS_MAC)
+  if (!UsesExternalPasswordManager() || !driver || IsOffTheRecord()) return {};
+  auto* frame = static_cast<password_manager::ContentPasswordManagerDriver*>(driver)
+                    ->render_frame_host();
+  if (!frame || content::WebContents::FromRenderFrameHost(frame) != web_contents() ||
+      !IsSavingAndFillingEnabled(frame->GetLastCommittedOrigin(), frame->GetLastCommittedURL()))
+    return {};
+  return boaz::CaptureNativePasswordSubmission(web_contents(), frame);
+#else
+  return {};
+#endif
+}
+void ChromePasswordManagerClient::CommitExternalPasswordSubmission(
+    const base::UnguessableToken& token, const std::u16string& username,
+    const std::u16string& password) {
+#if BUILDFLAG(IS_MAC)
+  if (!UsesExternalPasswordManager() || IsOffTheRecord() || token.is_empty()) return;
+  boaz::CommitNativePasswordSubmission(web_contents(), token, username, password);
+#endif
+}
