+bool ServerWrapper::Authorize(
+    int connection_id, const net::HttpServerRequestInfo& request) {
+  if (!bearer_token_) return true;
+  bool browser_request = request.headers.contains("origin");
+  for (const auto& [name, value] : request.headers) {
+    if (base::StartsWith(name, "sec-fetch-")) browser_request = true;
+  }
+  const std::string expected = "Bearer " + *bearer_token_;
+  const std::string supplied = request.GetHeaderValue("authorization");
+  if (!browser_request && supplied.size() == expected.size() &&
+      crypto::SecureMemEqual(base::as_byte_span(supplied),
+                             base::as_byte_span(expected))) {
+    return true;
+  }
+  net::HttpServerResponseInfo response(net::HTTP_UNAUTHORIZED);
+  response.SetBody("Unauthorized", "text/plain");
+  response.AddHeader("Connection", "close");
+  SendResponse(connection_id, response);
+  Close(connection_id);
+  return false;
+}
