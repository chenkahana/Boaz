+}
+
+void ChromeWebstorePrivateAPIDelegate::ShowUnsupportedExtensionParentApproval(
+    content::WebContents* web_contents,
+    base::OnceClosure cancelled) {
+#if BUILDFLAG(IS_MAC)
+  if (boaz::NativeHostEnabled()) {
+    boaz::ShowNativeExtensionParentApprovalUnavailable(web_contents,
+                                                      std::move(cancelled));
+    return;
+  }
+#endif
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, std::move(cancelled));
+}
