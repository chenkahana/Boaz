+
+// Inserts a Boaz item right before the first of `anchors` in the menu. False, with nothing inserted, without one.
+bool InsertBoazItemBefore(ui::SimpleMenuModel& menu, std::initializer_list<int> anchors, int id,
+                          const std::u16string& label) {
+  for (const int anchor : anchors) {
+    if (const std::optional<size_t> index = menu.GetIndexOfCommandId(anchor)) {
+      menu.InsertItemAt(*index, id, label);
+      return true;
     }
   }
+  return false;
