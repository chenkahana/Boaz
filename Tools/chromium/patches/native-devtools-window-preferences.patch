 void DevToolsUIBindings::RegisterPreference(const std::string& name,
                                             const RegisterOptions& options) {
+#if BUILDFLAG(IS_MAC)
+  if (boaz::GetNativeDevToolsPreference(delegate_->GetInspectedWebContents(), name)) return;
+#endif
   settings_.Register(name, options);
 }
 
 void DevToolsUIBindings::GetPreferences(DispatchCallback callback) {
-  base::Value settings = base::Value(settings_.Get());
+  auto values = settings_.Get();
+#if BUILDFLAG(IS_MAC)
+  for (const char* name : {"currentDockState", "lastDockState", "current-dock-state", "last-dock-state"}) {
+    if (auto value = boaz::GetNativeDevToolsPreference(delegate_->GetInspectedWebContents(), name))
+      values.Set(name, *value);
+  }
+#endif
+  base::Value settings(std::move(values));
   std::move(callback).Run(&settings);
 }
 
 void DevToolsUIBindings::GetPreference(DispatchCallback callback,
                                        const std::string& name) {
+#if BUILDFLAG(IS_MAC)
+  if (auto value = boaz::GetNativeDevToolsPreference(delegate_->GetInspectedWebContents(), name)) {
+    base::Value pref(*value);
+    std::move(callback).Run(&pref);
+    return;
+  }
+#endif
   base::Value pref = settings_.Get(name).value_or(base::Value());
   std::move(callback).Run(&pref);
 }
 
 void DevToolsUIBindings::SetPreference(const std::string& name,
                                        const std::string& value) {
+#if BUILDFLAG(IS_MAC)
+  if (boaz::SetNativeDevToolsPreference(delegate_->GetInspectedWebContents(), name, value)) return;
+#endif
   settings_.Set(name, value);
 }
 
 void DevToolsUIBindings::RemovePreference(const std::string& name) {
+#if BUILDFLAG(IS_MAC)
+  if (boaz::RemoveNativeDevToolsPreference(delegate_->GetInspectedWebContents(), name)) return;
+#endif
   settings_.Remove(name);
 }
 
