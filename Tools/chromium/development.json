{
  "configuration": "BoazDevelopment",
  "purpose": "Native host feasibility, not performance or release acceptance",
  "gn_args": {
    "root_extra_deps": [
      "//boaz:host"
    ],
    "target_cpu": "arm64",
    "is_debug": false,
    "is_official_build": false,
    "is_component_build": false,
    "dcheck_always_on": false,
    "enable_expensive_dchecks": false,
    "symbol_level": 0,
    "blink_symbol_level": 0,
    "v8_symbol_level": 0,
    "enable_dsyms": false,
    "use_thin_lto": false,
    "chrome_pgo_phase": 0,
    "use_lld": true,
    "use_system_xcode": true,
    "use_remoteexec": false,
    "use_siso": false,
    "proprietary_codecs": true,
    "ffmpeg_branding": "Chrome",
    "enable_widevine": true,
    "use_official_google_api_keys": false,
    "boaz_widevine_enabled": false
  }
}
