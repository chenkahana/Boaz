#!/usr/bin/env python3
"""Turn a crash report (.ips, the JSON format of macOS 12+ and iOS 15+) into a readable trace.

    Tools/symbolicate Boaz-2026-11-26-101500.ips [dSYM or folder of dSYMs ...]

Boaz's frames are resolved to function, file and line with atos, using the dSYM whose UUID matches the binary in the
report. dSYMs are taken from the paths given (a .dSYM, or a folder searched for them) and then from Spotlight, which
indexes Xcode's DerivedData and archives. Frames without a matching dSYM keep the symbol macOS wrote into the report,
or show image + offset. The report's own header (app, version, OS, device, exception) is printed first.

Limits: needs Xcode's command line tools (atos, dwarfdump). The dSYM must come from the very build that crashed: a
rebuild of the same commit has a different UUID and is not used. Chromium Framework frames resolve only when its
dSYM was kept from that build (the DMG release does not keep one yet); otherwise they show the exported symbol
macOS found, which for Chromium is usually just an offset. Inlined frames show the outer function. Text .crash
reports from before macOS 12 aren't read.
"""
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path


def load(path):
    """An .ips is a one-line JSON header followed by the JSON report."""
    text = Path(path).read_text(errors='replace')
    header_line, _, body = text.partition('\n')
    try:
        header = json.loads(header_line)
        report = json.loads(body)
    except json.JSONDecodeError:
        sys.exit(f'{path}: not a JSON .ips crash report (macOS 12+ / iOS 15+)')
    if 'threads' not in report or 'usedImages' not in report:
        sys.exit(f'{path}: an .ips without threads; only crash reports (bug_type 309) can be symbolicated')
    return header, report


def dwarf_files(path):
    path = Path(path)
    bundles = [path] if path.suffix == '.dSYM' else sorted(path.rglob('*.dSYM')) if path.is_dir() else []
    for bundle in bundles:
        yield from (item for item in (bundle / 'Contents/Resources/DWARF').glob('*') if item.is_file())


def uuids(dwarf):
    output = subprocess.run(['dwarfdump', '--uuid', str(dwarf)], capture_output=True, text=True).stdout
    return {match.upper() for match in re.findall(r'UUID: ([0-9A-Fa-f-]{36})', output)}


def find_dsyms(wanted, paths):
    found = {}
    for path in paths:
        for dwarf in dwarf_files(path):
            for uuid in uuids(dwarf) & wanted:
                found.setdefault(uuid, dwarf)
    for uuid in sorted(wanted - found.keys()):
        hits = subprocess.run(['mdfind', f'com_apple_xcode_dsym_uuids == {uuid}'],
                              capture_output=True, text=True).stdout.split('\n')
        for hit in filter(None, hits):
            dwarf = next((d for d in dwarf_files(hit) if uuid in uuids(d)), None)
            if dwarf:
                found[uuid] = dwarf
                break
    return found


def lookup(number, frame):
    """Callers' frames hold return addresses, one instruction past the call; look up the call itself."""
    return frame['imageOffset'] - (1 if number else 0)


def symbolicate(report, dsyms):
    """{(imageIndex, imageOffset): 'function (in Binary) (File.swift:12)'} for every frame atos resolves."""
    images = report['usedImages']
    wanted = {}
    stacks = [thread.get('frames', []) for thread in report['threads']] + [report.get('lastExceptionBacktrace', [])]
    for frames in stacks:
        for number, frame in enumerate(frames):
            index = frame.get('imageIndex')
            if index is not None and images[index].get('uuid', '').upper() in dsyms:
                wanted.setdefault(index, set()).add(lookup(number, frame))
    resolved = {}
    for index, offsets in wanted.items():
        image = images[index]
        offsets = sorted(offsets)
        base = image['base']
        output = subprocess.run(['atos', '-arch', image.get('arch', 'arm64'), '-o',
                                 str(dsyms[image['uuid'].upper()]), '-l', hex(base),
                                 *(hex(base + offset) for offset in offsets)],
                                capture_output=True, text=True, check=True).stdout.splitlines()
        for offset, line in zip(offsets, output):
            if not line.startswith('0x'):  # atos echoes the address when it has no symbol for it.
                resolved[index, offset] = line.strip()
    return resolved


def frame_line(number, frame, images, resolved):
    index = frame.get('imageIndex')
    image = images[index] if index is not None else {}
    name = image.get('name') or Path(image.get('path', '???')).name
    offset = frame.get('imageOffset', 0)
    where = resolved.get((index, lookup(number, frame)))
    if where is None and frame.get('symbol'):
        where = f"{frame['symbol']} + {frame.get('symbolLocation', 0)}"
        where += f" ({Path(frame['sourceFile']).name}:{frame['sourceLine']})" if frame.get('sourceLine') else ''
    where = re.sub(r' \(in [^)]*\)', '', where) if where else f'{hex(image.get("base", 0) + offset)} {hex(image.get("base", 0))} + {offset}'
    return f'{number:<3} {name[:28]:<28} {where}'


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('report', help='the .ips file')
    parser.add_argument('dsyms', nargs='*', help='.dSYM bundles or folders holding them')
    parser.add_argument('--all-threads', action='store_true', help='print every thread, not only the crashed one')
    args = parser.parse_args()
    header, report = load(args.report)
    images = report['usedImages']
    dsyms = find_dsyms({image.get('uuid', '').upper() for image in images if image.get('uuid')}, args.dsyms)
    resolved = symbolicate(report, dsyms)

    bundle = report.get('bundleInfo', {})
    system = report.get('osVersion', {})
    version = bundle.get('CFBundleShortVersionString') or header.get('app_version')
    build = bundle.get('CFBundleVersion') or header.get('build_version')
    print(' · '.join(filter(None, [
        report.get('procName', header.get('app_name', '?')) + (f' {version}' if version else '')
        + (f' ({build})' if build else ''),
        f"{system.get('train', '?')} ({system.get('build', '?')})" if system else header.get('os_version'),
        report.get('modelCode')])))
    print(f"Crashed: {report.get('captureTime', header.get('timestamp', '?'))}")
    exception = report.get('exception', {})
    if exception:
        print('Exception: ' + ' '.join(str(exception[key]) for key in ('type', 'signal', 'subtype') if key in exception))
    termination = report.get('termination', {})
    if termination.get('indicator'):
        print(f"Termination: {termination['indicator']}")
    for key in ('asi', 'crashInfo'):  # Swift fatalError / precondition messages land in asi.
        for owner, messages in (report.get(key) or {}).items():
            print(f'{owner}: ' + ' '.join(messages if isinstance(messages, list) else [str(messages)]))
    ours = sorted({images[i]['name'] for i, _ in resolved})
    missing = sorted({image.get('name', '?') for image in images
                      if image.get('uuid', '').upper() not in dsyms and 'Boaz' in image.get('path', '')})
    print(f"Symbolicated with dSYMs: {', '.join(ours) or 'none'}"
          + (f"; no dSYM for: {', '.join(missing)}" if missing else ''))

    backtrace = report.get('lastExceptionBacktrace')
    if backtrace:
        print('\nLast exception backtrace:')
        for number, frame in enumerate(backtrace):
            print(frame_line(number, frame, images, resolved))
    crashed = report.get('faultingThread', 0)
    for number, thread in enumerate(report['threads']):
        if number != crashed and not args.all_threads:
            continue
        label = ' (crashed)' if number == crashed else ''
        queue = f"  queue {thread['queue']}" if thread.get('queue') else ''
        print(f'\nThread {number}{label}{queue}:')
        for index, frame in enumerate(thread.get('frames', [])):
            print(frame_line(index, frame, images, resolved))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
